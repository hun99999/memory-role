# Merge this table into ~/.codex/config.toml. Replace the command with the output of:
# command -v basic-memory
[mcp_servers.basic-memory]
command = "/ABSOLUTE/PATH/TO/basic-memory"
args = ["mcp"]
startup_timeout_sec = 30
enabled_tools = ["search_notes", "read_note", "write_note", "edit_note", "list_directory", "list_memory_projects"]
